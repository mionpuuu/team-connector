<div class="max-w-3xl mx-auto p-6 bg-white rounded-2xl shadow-md mt-8">
  <h1 class="text-2xl font-bold text-indigo-700 mb-6 text-center">試合情報を編集</h1>

  <%= form_with(model: @event, local: true) do |f| %>
    <% if @event.errors.any? %>
      <div class="mb-4 p-4 bg-red-50 border border-red-300 text-red-700 rounded-lg">
        <p><strong><%= pluralize(@event.errors.count, "件のエラー") %></strong> が発生しました:</p>
        <ul class="list-disc list-inside">
          <% @event.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= f.label :title, "試合タイトル", class: "block text-gray-700 font-semibold mb-1" %>
        <%= f.text_field :title, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-400 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :date, "日付", class: "block text-gray-700 font-semibold mb-1" %>
        <%= f.date_field :date, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-400 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :location, "場所", class: "block text-gray-700 font-semibold mb-1" %>
        <%= f.text_field :location, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-400 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :description, "詳細", class: "block text-gray-700 font-semibold mb-1" %>
        <%= f.text_area :description, rows: 4, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-400 focus:outline-none" %>
      </div>

      <div>
      <%= f.label :images, "試合画像・要項", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.file_field :images, multiple: true, accept: "image/*",
        class: "block w-full text-sm text-gray-700 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 focus:outline-none" %>

     <% if @event.images.attached? %>
       <div class="grid grid-cols-3 gap-2 mt-3">
          <% @event.images.each do |img| %>
         <%= image_tag img.variant(resize_to_limit: [150, 150]), class: "rounded-lg shadow-sm" %>
        <% end %>
    </div>
  <% end %>
</div>
    </div>

    <div class="mt-6 flex justify-between items-center">
      <%= f.submit "更新する", class: "bg-indigo-600 text-white px-5 py-2 rounded-lg shadow hover:bg-indigo-700 transition" %>
      <%= link_to "キャンセル", root_path, class: "text-gray-600 hover:underline" %>
    </div>
  <% end %>

  <div class="mt-8 text-center border-t pt-4">
    <%= button_to "試合を削除する", event_path(@event), method: :delete, 
        data: { turbo_confirm: "本当に削除しますか？" },
        class: "bg-red-500 text-white px-5 py-2 rounded-lg shadow hover:bg-red-600 transition" %>
  </div>
</div>
