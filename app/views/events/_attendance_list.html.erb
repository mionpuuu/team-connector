<h3 class="text-lg sm:text-xl font-extrabold text-gray-800 mb-3 sm:mb-4 flex items-center">
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
       stroke-width="2" stroke="currentColor" class="w-6 h-6 mr-2 text-indigo-600">
    <path stroke-linecap="round" stroke-linejoin="round"
          d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>
  </svg>
  参加状況
</h3>

<% if defined?(@attendance_counts) && @attendance_counts %>
  <div class="mb-5 p-4 bg-indigo-50 rounded-xl border-2 border-indigo-200">
    <h4 class="text-sm font-bold text-gray-700 mb-3">現在の状況</h4>
    <div class="space-y-2">
      <!-- 参加 -->
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <span class="text-2xl mr-2">◯</span>
          <span class="font-medium text-gray-700">参加</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="flex">
            <% @attendance_counts[:attending].times do %>
              <span class="w-3 h-3 bg-green-500 rounded-full mr-1"></span>
            <% end %>
          </div>
          <span class="font-bold text-green-700"><%= @attendance_counts[:attending] %>人</span>
        </div>
      </div>

      <!-- 未定 -->
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <span class="text-2xl mr-2">△</span>
          <span class="font-medium text-gray-700">未定</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="flex">
            <% @attendance_counts[:pending].times do %>
              <span class="w-3 h-3 bg-yellow-500 rounded-full mr-1"></span>
            <% end %>
          </div>
          <span class="font-bold text-yellow-700"><%= @attendance_counts[:pending] %>人</span>
        </div>
      </div>

      <!-- 不参加 -->
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <span class="text-2xl mr-2">×</span>
          <span class="font-medium text-gray-700">不参加</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="flex">
            <% @attendance_counts[:absent].times do %>
              <span class="w-3 h-3 bg-red-500 rounded-full mr-1"></span>
            <% end %>
          </div>
          <span class="font-bold text-red-700"><%= @attendance_counts[:absent] %>人</span>
        </div>
      </div>

    <!-- 合計 -->
    <div class="mt-3 pt-3 border-t border-indigo-300">
      <div class="flex items-center justify-between">
        <span class="font-bold text-gray-800">合計</span>
        <span class="font-bold text-indigo-700 text-lg">
          <%= @attendance_counts[:responded] %> / <%= @attendance_counts[:total_members] %>人が回答
        </span>
      </div>
    </div>
  </div>
<% end %>

<!-- 詳細リスト -->
<% if event.attendances.any? %>
  <h4 class="text-sm font-bold text-gray-700 mb-3 mt-5">メンバー別詳細</h4>
  <ul class="space-y-2">
    <% event.attendances.includes(:user).each do |attendance| %>
      
      <li class="p-3 bg-gray-50 rounded-lg">
        <span class="font-bold text-gray-800"><%= attendance.user.username %></span>
        <span class="mx-2">:</span>
        <% case attendance.status %>
        <% when "attending" %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold bg-green-100 text-green-700">
            ◯ 参加
          </span>
        <% when "absent" %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold bg-red-100 text-red-700">
            × 不参加
          </span>
        <% when "pending" %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold bg-yellow-100 text-yellow-700">
            △ 未定
          </span>
        <% else %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold bg-gray-100 text-gray-600">
            未回答
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-gray-600 text-center py-4">まだ回答がありません。</p>
<% end %>