<div class="min-h-screen bg-gray-100">
  
  <!-- ヘッダーエリア -->
  <header class="bg-white shadow-lg sticky top-0 z-10 border-b-4 border-indigo-500">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between gap-x-4">
      <h1 class="text-2xl font-extrabold text-indigo-600 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor"
             class="w-7 h-7 mr-2 text-indigo-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Team Connector
      </h1>

      <%= link_to edit_user_registration_path, class: "ml-4 text-gray-600 hover:text-indigo-600 transition duration-150 p-2 rounded-full bg-indigo-50" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor"
             class="w-6 h-6 text-indigo-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M5.121 17.804A9 9 0 0112 15a9 9 0 016.879 2.804M15 10a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      <% end %>
    </div>
  </header>
  
  <main class="max-w-4xl mx-auto p-4 sm:p-6 lg:p-8">
    
    <!-- パンくずナビゲーション -->
    <div class="mb-6 flex items-center text-sm text-gray-600">
      <%= link_to root_path, class: "hover:text-indigo-600 transition flex items-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        ダッシュボード
      <% end %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
           stroke-width="2" stroke="currentColor" class="w-4 h-4 mx-2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
      <%= link_to events_path, class: "hover:text-indigo-600 transition" do %>
        試合一覧
      <% end %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
           stroke-width="2" stroke="currentColor" class="w-4 h-4 mx-2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-gray-900 font-medium">アーカイブ</span>
    </div>

    <!-- ページタイトル -->
    <div class="mb-6">
      <h2 class="text-3xl font-bold text-gray-900 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round"
            class="w-8 h-8 mr-2 text-indigo-600">
          <path d="M16 2v4"/>
          <path d="M21 11.75V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h7.25"/>
          <path d="m22 22-1.875-1.875"/>
          <path d="M3 10h18"/>
          <path d="M8 2v4"/>
          <circle cx="18" cy="18" r="3"/>
        </svg>
        試合アーカイブ
      </h2>
      <p class="text-gray-600 mt-2">過去の試合記録を月ごとに確認できます</p>
    </div>
    
    <!-- アーカイブセクション -->
    <% if @events_by_month.present? %>
      <div class="space-y-6">
        <% @events_by_month.each do |month, events| %>
          <section class="p-6 bg-white rounded-2xl shadow-xl border-t-8 border-indigo-500">
            <!-- 月ヘッダー -->
            <h3 class="text-2xl font-extrabold text-indigo-700 mb-5 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                   class="w-6 h-6 mr-2">
                <path d="M8 2v4"/>
                <path d="M16 2v4"/>
                <rect width="18" height="18" x="3" y="4" rx="2"/>
                <path d="M3 10h18"/>
              </svg>
              <%= month %>
              <span class="ml-3 text-sm font-normal text-gray-600 bg-indigo-100 px-3 py-1 rounded-full">
                <%= events.count %>件
              </span>
            </h3>

            <!-- 試合リスト -->
            <ul class="space-y-3">
              <% events.each do |event| %>
                <li class="p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition duration-150 border border-gray-200">
                  <% wdays = ['日', '月', '火', '水', '木', '金', '土'] %>
                  <% wday = wdays[event.date.wday] %>
                  
                  <%= link_to event_path(event), class: "group block" do %>
                    <div class="flex items-start justify-between">
                      <div class="flex-1">
                        <div class="flex items-center mb-1">
                          <span class="text-lg font-bold text-indigo-700 mr-3">
                            <%= event.date.strftime("%-m/%-d") %>（<%= wday %>）
                          </span>
                          <span class="text-sm text-gray-600 font-medium">
                            <%= event.time.present? ? event.time.strftime("%H:%M") : '時間未定' %>
                          </span>
                        </div>
                        <p class="text-base font-bold text-gray-900 group-hover:text-indigo-800 transition mb-1">
                          <%= event.title %>
                        </p>
                        <% if event.location.present? %>
                          <p class="text-sm text-gray-600 flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                 stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                              <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                              <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                            </svg>
                            <%= event.location %>
                          </p>
                        <% end %>
                      </div>
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600 group-hover:translate-x-1 transition flex-shrink-0 mt-1"><path d="m9 18 6-6-6-6"/></svg>
                    </div>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>
    <% else %>
      <!-- 空状態 -->
      <section class="p-6 bg-white rounded-2xl shadow-xl border-t-8 border-indigo-500">
        <div class="text-center py-12">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke-width="1.5" stroke="currentColor"
               class="w-16 h-16 mx-auto text-gray-400 mb-4">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
          </svg>
          <p class="text-gray-600 text-lg">過去の試合はまだありません。</p>
          <p class="text-gray-500 text-sm mt-2">試合が終了すると、ここに記録が保存されます。</p>
        </div>
      </section>
    <% end %>

    <!-- 試合一覧に戻るリンク -->
    <div class="flex justify-center mt-8">
      <%= link_to events_path,
          class: "flex items-center gap-2 px-6 py-3 bg-white hover:bg-gray-50 rounded-xl border-2 border-gray-300 shadow-md transition duration-150 text-gray-700 font-medium" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        試合一覧に戻る
      <% end %>
    </div>

  </main>
</div>