<div class="min-h-screen bg-gray-100">
  
  <!-- ヘッダーエリア -->
   <%= render 'shared/header', color: 'indigo' %>
  
  <main class="max-w-4xl mx-auto p-4 sm:p-6 lg:p-8">
    
    <!-- パンくずナビゲーション -->
    <div class="mb-6 flex items-center text-sm text-gray-600">
      <%= link_to root_path, class: "hover:text-indigo-600 transition flex items-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        ダッシュボード
      <% end %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
           stroke-width="2" stroke="currentColor" class="w-4 h-4 mx-2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-gray-900 font-medium">試合一覧</span>
    </div>

    <!-- ページタイトル & アクションボタン -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 gap-4">
      <h2 class="text-3xl font-bold text-gray-900 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             class="w-8 h-8 mr-2 text-indigo-600">
          <path d="M8 2v4"/>
          <path d="M16 2v4"/>
          <rect width="18" height="18" x="3" y="4" rx="2"/>
          <path d="M3 10h18"/>
        </svg>
        試合一覧
      </h2>

      <%= link_to new_event_path,
          class: "flex items-center justify-center bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition duration-150 transform hover:scale-[1.02]" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        試合作成
      <% end %>
    </div>
    
    <!-- 試合一覧セクション -->
    <section class="mb-8 p-6 bg-white rounded-2xl shadow-xl border-t-8 border-indigo-500">
      
      <% if @events.any? %>
        <ul class="space-y-4">
          <% @events.each do |event| %>
            <li class="p-4 bg-indigo-50 rounded-xl hover:bg-indigo-100 transition duration-150 border border-indigo-200">
              <% wdays = ['日', '月', '火', '水', '木', '金', '土'] %>
              <% wday = wdays[event.date.wday] %>
              
              <%= link_to event_path(event), class: "group block" do %>
                <div class="flex items-center justify-between">
                  <div class="flex items-center">
                    <span class="text-xl font-bold text-indigo-700 mr-3">
                      <%= event.date.strftime("%-m/%-d") %>（<%= wday %>）
                    </span>
                    <span class="text-base text-gray-700 font-medium">
                      <%= event.time.present? ? event.time.strftime("%H:%M") : '時間未定' %>
                    </span>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600 group-hover:translate-x-1 transition"><path d="m9 18 6-6-6-6"/></svg>
                </div>
                <p class="mt-1 text-lg font-bold text-gray-900 group-hover:text-indigo-800 transition">
                  <%= event.title %>
                </p>
                <% if event.location.present? %>
                  <p class="mt-1 text-sm text-gray-600 flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                      <path stroke-linecap="round" stroke-linejoin="round"
                            d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round"
                            d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                    </svg>
                    <%= event.location %>
                  </p>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="text-center py-12">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke-width="1.5" stroke="currentColor"
               class="w-16 h-16 mx-auto text-gray-400 mb-4">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
          </svg>
          <p class="text-gray-600 text-lg">登録された試合はまだありません。</p>
          <p class="text-gray-500 text-sm mt-2">「試合作成」ボタンから新しい試合を登録しましょう!</p>
        </div>
      <% end %>
    </section>

    <!-- 過去の試合を見るリンク -->
    <div class="flex justify-center mb-6">
      <%= link_to archive_events_path,
          class: "flex items-center justify-center gap-2 px-6 py-3 bg-white hover:bg-gray-50 rounded-xl border-2 border-gray-300 shadow-md transition duration-150 text-gray-700 font-medium" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round"
            class="w-5 h-5 text-indigo-600">
          <path d="M16 2v4"/>
          <path d="M21 11.75V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h7.25"/>
          <path d="m22 22-1.875-1.875"/>
          <path d="M3 10h18"/>
          <path d="M8 2v4"/>
          <circle cx="18" cy="18" r="3"/>
        </svg>
        過去の試合を見る
      <% end %>
    </div>

    <div class="flex justify-center">
      <%= link_to root_path,
          class: "flex items-center gap-2 px-6 py-3 bg-white hover:bg-gray-50 rounded-xl border-2 border-gray-300 shadow-md transition duration-150 text-gray-700 font-medium" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        ダッシュボードに戻る
      <% end %>
    </div>

  </main>
</div>