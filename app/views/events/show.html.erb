<div class="min-h-screen bg-gray-100" data-controller="modal">
  
  <!-- ヘッダーエリア -->
  <header class="bg-white shadow-lg sticky top-0 z-10 border-b-4 border-indigo-500">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between gap-x-4">
      <h1 class="text-2xl font-extrabold text-indigo-600 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor"
             class="w-7 h-7 mr-2 text-indigo-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Team Connector
      </h1>

      <%= link_to edit_user_registration_path, class: "ml-4 text-gray-600 hover:text-indigo-600 transition duration-150 p-2 rounded-full bg-indigo-50" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor"
             class="w-6 h-6 text-indigo-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M5.121 17.804A9 9 0 0112 15a9 9 0 016.879 2.804M15 10a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      <% end %>
    </div>
  </header>
  
  <main class="max-w-4xl mx-auto p-3 sm:p-6 lg:p-8">
    
    <!-- パンくずナビゲーション -->
    <div class="mb-6 flex items-center text-sm text-gray-600">
      <%= link_to root_path, class: "hover:text-indigo-600 transition flex items-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        ダッシュボード
      <% end %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
           stroke-width="2" stroke="currentColor" class="w-4 h-4 mx-2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
      <%= link_to events_path, class: "hover:text-indigo-600 transition" do %>
        試合一覧
      <% end %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
           stroke-width="2" stroke="currentColor" class="w-4 h-4 mx-2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-gray-900 font-medium truncate"><%= truncate(@event.title, length: 20) %></span>
    </div>

    <!-- タイトルセクション -->
    <div class="mb-4 p-4 sm:p-6 bg-white rounded-2xl shadow-xl border-t-8 border-indigo-500">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-3 sm:mb-4"><%= @event.title %></h2>
      
      <div class="space-y-2 sm:space-y-3 text-gray-700">
        <div class="flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-2 text-indigo-600">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span class="font-bold text-indigo-700">
            <%= @event.date.strftime("%Y年%-m月%-d日（#{['日','月','火','水','木','金','土'][@event.date.wday]}）") %>
          </span>
        </div>

        <% if @event.time.present? %>
          <div class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-2 text-indigo-600">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="font-medium"><%= @event.time.strftime("%H:%M") %></span>
          </div>
        <% end %>

        <% if @event.location.present? %>
          <div class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-2 text-indigo-600">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
            </svg>
            <span class="font-medium"><%= @event.location %></span>
          </div>
        <% end %>

        <% if @event.description.present? %>
          <div class="mt-3 sm:mt-4 pt-3 sm:pt-4 border-t border-gray-200">
            <p class="text-sm text-gray-600 font-semibold mb-2">詳細</p>
            <p class="text-gray-700 whitespace-pre-wrap"><%= @event.description %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- 画像セクション -->
    <% if @event.images.attached? %>
      <section class="mb-4 p-4 sm:p-6 bg-white rounded-2xl shadow-xl border-t-8 border-indigo-500">
        <h3 class="text-lg sm:text-xl font-extrabold text-gray-800 mb-3 sm:mb-4 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke-width="2" stroke="currentColor" class="w-6 h-6 mr-2 text-indigo-600">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/>
          </svg>
          画像
        </h3>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
          <% @event.images.each do |img| %>
            <%= image_tag img.variant(resize_to_limit: [300, 300]),
                class: "rounded-xl shadow-md cursor-pointer transition hover:scale-105 w-full h-32 sm:h-48 object-cover",
                data: { action: "click->modal#open", modal_target: "image", full_url: url_for(img) } %>
          <% end %>
        </div>

        <!-- モーダル本体 -->
        <div data-modal-target="modal"
             class="hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50"
             data-action="click->modal#close">
          <img data-modal-target="modalImage" class="max-h-[80vh] rounded-lg shadow-lg" alt="preview">
        </div>
      </section>
    <% end %>

    <!-- 出欠ボタン -->
    <% if user_signed_in? %>
      <section class="mb-4 p-4 sm:p-6 bg-white rounded-2xl shadow-xl border-t-8 border-indigo-500">
        <h3 class="text-lg sm:text-xl font-extrabold text-gray-800 mb-3 sm:mb-4 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke-width="2" stroke="currentColor" class="w-6 h-6 mr-2 text-indigo-600">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          あなたの出欠を回答
        </h3>
        
        <div class="flex flex-col sm:flex-row justify-center gap-3 sm:gap-4">
          <%= form_with url: attend_event_path(@event), method: :post, remote: true, class: "flex-1 sm:flex-initial" do |f| %>
            <%= hidden_field_tag :notice, "" %>
            <%= f.submit "◯ 参加", class: "w-full bg-green-500 hover:bg-green-600 text-white font-bold py-2.5 sm:py-3 px-6 sm:px-8 rounded-xl shadow-lg transition duration-150 transform hover:scale-[1.02] cursor-pointer text-sm sm:text-base" %>
          <% end %>

          <%= form_with url: pending_event_path(@event), method: :post, remote: true, class: "flex-1 sm:flex-initial" do |f| %>
            <%= hidden_field_tag :notice, "" %>
            <%= f.submit "△ 未定", class: "w-full bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2.5 sm:py-3 px-6 sm:px-8 rounded-xl shadow-lg transition duration-150 transform hover:scale-[1.02] cursor-pointer text-sm sm:text-base" %>
          <% end %>

          <%= form_with url: cancel_event_path(@event), method: :post, remote: true, class: "flex-1 sm:flex-initial" do |f| %>
            <%= hidden_field_tag :notice, "" %>
            <%= f.submit "× 不参加", class: "w-full bg-red-500 hover:bg-red-600 text-white font-bold py-2.5 sm:py-3 px-6 sm:px-8 rounded-xl shadow-lg transition duration-150 transform hover:scale-[1.02] cursor-pointer text-sm sm:text-base" %>
          <% end %>
        </div>
      </section>
    <% end %>

    <!-- 参加状況 -->
    <!-- 参加状況 -->
    <section id="attendance-section" class="mb-4 p-4 sm:p-6 bg-white rounded-2xl shadow-xl border-t-8 border-indigo-500">
       <%= render partial: 'attendance_list', locals: { event: @event } %>
    </section>

    <!-- コメント欄 -->
    <section class="mb-4 p-4 sm:p-6 bg-white rounded-2xl shadow-xl border-t-8 border-sky-500">
      <h3 class="text-lg sm:text-xl font-extrabold text-gray-800 mb-3 sm:mb-4 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor" class="w-6 h-6 mr-2 text-sky-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/>
        </svg>
        コメント
      </h3>

      <% if user_signed_in? %>
        <%= form_with(model: [@event, Comment.new], local: true, class: "mb-4 sm:mb-6") do |f| %>
          <div class="flex flex-col sm:flex-row gap-3">
            <%= f.text_field :content,
                placeholder: "コメントを入力...",
                class: "flex-1 border-2 border-gray-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 transition" %>
            <%= f.submit "送信",
                class: "bg-sky-600 hover:bg-sky-700 text-white px-6 py-3 rounded-xl font-bold shadow-lg transition duration-150 transform hover:scale-[1.02] cursor-pointer" %>
          </div>
        <% end %>
      <% end %>

      <% if @comments.any? %>
        <ul class="space-y-3">
          <% @comments.each do |comment| %>
            <li class="p-4 bg-sky-50 rounded-xl border border-sky-200">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <span class="font-bold text-gray-800"><%= comment.user.username %></span>
                  <p class="mt-1 text-gray-700"><%= comment.content %></p>
                </div>
              </div>
              <p class="text-xs text-gray-500 mt-2">
                <%= comment.created_at.strftime("%Y年%-m月%-d日 %H:%M") %>
              </p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-600 text-center py-4">まだコメントがありません。</p>
      <% end %>
    </section>

    <!-- 編集・削除ボタン -->
    <% if user_signed_in? && @event.user == current_user %>
      <div class="flex flex-col sm:flex-row justify-center gap-3 sm:gap-4 mb-4 sm:mb-6">
        <%= link_to edit_event_path(@event),
            class: "flex items-center bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition duration-150 transform hover:scale-[1.02]" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
          </svg>
          編集
        <% end %>

        <%= button_to event_path(@event), method: :delete,
            data: { turbo_confirm: "本当に削除しますか?" },
            class: "flex items-center bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition duration-150 transform hover:scale-[1.02]" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
          </svg>
          削除
        <% end %>
      </div>
    <% end %>

    <!-- 戻るリンク -->
    <div class="flex justify-center">
      <%= link_to events_path,
          class: "flex items-center gap-2 px-6 py-3 bg-white hover:bg-gray-50 rounded-xl border-2 border-gray-300 shadow-md transition duration-150 text-gray-700 font-medium" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        試合一覧に戻る
      <% end %>
    </div>

  </main>
</div>