<div class="max-w-3xl mx-auto p-8 bg-white rounded-2xl shadow-md mt-8" data-controller="modal">
  <h1 class="text-3xl font-bold mb-4 text-indigo-700"><%= @event.title %></h1>

  <p>
    <strong>日付:</strong>
    <%= @event.date.strftime("%Y年%-m月%-d日（#{['日','月','火','水','木','金','土'][@event.date.wday]}）") %>
  </p>

  <% if @event.time.present? %>
    <p><strong>時間:</strong> <%= @event.time.strftime("%H:%M") %></p>
  <% end %>

  <p><strong>場所:</strong> <%= @event.location %></p>
  <p class="mb-6"><strong>詳細:</strong> <%= @event.description %></p>

  <% if @event.images.attached? %>
    <div class="grid grid-cols-3 gap-3 mb-6">
      <% @event.images.each do |img| %>
        <%= image_tag img.variant(resize_to_limit: [180, 180]),
            class: "rounded-lg shadow-md cursor-pointer transition hover:scale-105",
            data: { action: "click->modal#open", modal_target: "image", full_url: url_for(img) } %>
      <% end %>
    </div>

    <!-- モーダル本体 -->
    <div data-modal-target="modal"
         class="hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50"
         data-action="click->modal#close">
      <img data-modal-target="modalImage" class="max-h-[80vh] rounded-lg shadow-lg" alt="preview">
    </div>
  <% end %>

  <% if user_signed_in? %>
  <!-- ボタン群 -->
  <div class="flex justify-center mb-6">
  <%= form_with url: attend_event_path(@event), method: :post, remote: true, style: "display:inline-block; margin: 0 6px;" do |f| %>
    <%= hidden_field_tag :notice, "" %>
    <%= f.submit "◯", style: "background:#22c55e; color:white; padding:12px 24px; border-radius:12px; font-weight:bold;" %>
  <% end %>

  <%= form_with url: cancel_event_path(@event), method: :post, remote: true, style: "display:inline-block; margin: 0 6px;" do |f| %>
    <%= hidden_field_tag :notice, "" %>
    <%= f.submit "×", style: "background:#ef4444; color:white; padding:12px 24px; border-radius:12px; font-weight:bold;" %>
  <% end %>

  <%= form_with url: pending_event_path(@event), method: :post, remote: true, style: "display:inline-block; margin: 0 6px;" do |f| %>
    <%= hidden_field_tag :notice, "" %>
    <%= f.submit "△", style: "background:#eab308; color:white; padding:12px 24px; border-radius:12px; font-weight:bold;" %>
  <% end %>
</div>
  <% end %>

  <!-- 参加状況 -->
  <div class="mt-8 border-t pt-4">
  <h3 class="text-lg font-bold mb-2 text-gray-800">参加状況</h3>

  <% if @event.attendances.any? %>
    <ul class="space-y-1">
      <% @event.attendances.includes(:user).each do |attendance| %>
        <li>
          <span class="font-medium"><%= attendance.user.username %>：</span>

          <% case attendance.status %>
          <% when "attending" %>
            <span class="text-green-600 font-semibold">◯</span>
          <% when "absent" %>
            <span class="text-red-600 font-semibold">×</span>
          <% when "pending" %>
            <span class="text-yellow-500 font-semibold">△</span>
          <% else %>
            <span class="text-gray-500">未回答</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500">まだ回答がありません。</p>
  <% end %>
</div>

  <!-- コメント欄 -->
<div class="mt-8 border-t pt-4">
  <h3 class="text-lg font-bold mb-2 text-gray-800">コメント</h3>

  <% if user_signed_in? %>
    <%= form_with(model: [@event, Comment.new], local: true, class: "flex space-x-2 mb-4") do |f| %>
      <%= f.text_field :content,
          placeholder: "コメント（任意）",
          class: "border border-gray-300 rounded-lg px-3 py-2 w-64 focus:ring-indigo-500 focus:border-indigo-500" %>
      <%= f.submit "送信",
          class: "bg-indigo-500 text-white px-4 py-2 rounded-lg bg-indigo-600 transition" %>
    <% end %>
  <% end %>

  <% if @comments.any? %>
    <ul class="space-y-2">
      <% @comments.each do |comment| %>
        <li>
          <span class="font-medium"><%= comment.user.username %>：</span>
          <%= comment.content %>
          <span class="text-gray-400 text-xs ml-2">（<%= comment.created_at.strftime("%Y/%m/%d %H:%M") %>）</span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500">まだコメントがありません。</p>
  <% end %>
</div>

  <!-- 編集・削除ボタン -->
  <% if user_signed_in? && @event.user == current_user %>
  <div class="flex justify-center items-center border-t pt-4">
    <div class="flex space-x-3">
      <%= link_to "編集", edit_event_path(@event),
          class: "bg-indigo-600 text-white px-4 py-2 rounded-lg shadow hover:bg-indigo-700 transition" %>

      <%= button_to "削除", event_path(@event), method: :delete,
          data: { turbo_confirm: "本当に削除しますか？" },
          class: "bg-red-500 text-white px-4 py-2 rounded-lg shadow hover:bg-red-600 transition" %>
    </div>
  </div>
  <% end %>


  <div class="flex justify-center items-center mt-4">
      <%= link_to "← 試合一覧に戻る", events_path, class: "text-indigo-600 hover:underline" %>
</div>
</div>
