<%
  text ||= "詳細を見る"
  url ||= "#"
  variant ||= :secondary
%>

<%
  base_classes = "flex items-center justify-start font-medium rounded-lg transition duration-150 shadow-sm text-sm space-x-1"

  variant_classes = case variant
    when :primary
      "bg-indigo-600 text-white hover:bg-indigo-700 px-4 py-2"
    when :secondary
      "bg-indigo-50 text-indigo-700 hover:bg-indigo-100 px-3 py-1.5"
    when :link
      "text-gray-600 hover:text-gray-800"
    else
      "text-indigo-600 hover:text-indigo-700"
  end
%>

<%= link_to url, class: "#{base_classes} #{variant_classes}" do %>
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
       stroke-width="2" stroke="currentColor" class="w-4 h-4">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m2 0a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>
  <span><%= text %></span>
<% end %>
