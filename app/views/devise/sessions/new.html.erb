<div class="min-h-screen bg-gray-100 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  
  <div class="max-w-md w-full">
    
    <!-- ロゴとタイトル -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-indigo-600 rounded-2xl shadow-xl mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2.5" stroke="currentColor" class="w-9 h-9 text-white">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
      </div>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-2">
        Team Connector
      </h1>
      <p class="text-sm text-gray-600">「つなぐことで、チームをもっとスムーズに。」</p>
    </div>

    <!-- ログインフォーム -->
    <div class="bg-white rounded-2xl shadow-xl border-t-8 border-indigo-500 p-8">
      <h2 class="text-2xl font-bold text-gray-900 text-center mb-6 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor" class="w-6 h-6 mr-2 text-indigo-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75"/>
        </svg>
        ログイン
      </h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        
        <!-- メールアドレス -->
        <div>
          <%= f.label :email, class: "block text-sm font-bold text-gray-700 mb-2 flex items-center" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-1 text-indigo-600">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
            </svg>
            メールアドレス
          <% end %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              required: true,
              class: "w-full border-2 border-gray-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition",
              placeholder: "example@team.com" %>
        </div>

        <!-- パスワード -->
        <div>
          <%= f.label :password, class: "block text-sm font-bold text-gray-700 mb-2 flex items-center" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-1 text-indigo-600">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
            </svg>
            パスワード
          <% end %>
          <%= f.password_field :password,
              autocomplete: "current-password",
              required: true,
              class: "w-full border-2 border-gray-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition",
              placeholder: "パスワードを入力" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <!-- ログイン状態を保持 -->
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" %>
            <%= f.label :remember_me, "ログイン状態を保持する", class: "ml-2 text-sm text-gray-700" %>
          </div>
        <% end %>

        <!-- ログインボタン -->
        <div class="pt-2">
          <%= f.submit "ログイン",
              class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-4 px-6 rounded-xl shadow-lg transition duration-150 transform hover:scale-[1.02] cursor-pointer" %>
        </div>

      <% end %>

      <!-- パスワード忘れ -->
      <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
        <div class="mt-4 text-center">
          <%= link_to new_user_password_path,
              class: "text-sm text-gray-600 hover:text-indigo-600 transition" do %>
            パスワードをお忘れですか?
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- 新規登録リンク -->
    <% if devise_mapping.registerable? && controller_name != 'registrations' %>
      <div class="mt-6 text-center p-6 bg-white rounded-2xl shadow-lg">
        <p class="text-sm text-gray-600 mb-3">アカウントをお持ちでない方</p>
        <%= link_to new_user_registration_path,
            class: "inline-flex items-center justify-center w-full bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold py-3 px-6 rounded-xl transition duration-150" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z"/>
          </svg>
          新規登録はこちら
        <% end %>
      </div>
    <% end %>

  </div>

</div>