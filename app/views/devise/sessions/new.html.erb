<div class="app-container">

<!-- アプリロゴとタイトル -->
<header class="text-center mb-8">
    <div class="w-12 h-12 mx-auto bg-indigo-600 rounded-full flex items-center justify-center mb-3 shadow-lg">
        <%# Lucide icon for the application %>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap text-white">
            <path d="M10.875 14.773a4.5 4.5 0 0 0 4.09 3.033A5.5 5.5 0 0 0 19.5 13.5c0-.85-.188-1.65-.522-2.37A6.99 6.99 0 0 0 12 4.5V2l-4 4 4 4V7.5a4.5 4.5 0 0 1 4.5 4.5c0 1.05-.27 2.02-.738 2.85M13 18l-4 4-4-4"/>
        </svg>
    </div>
    <h1 class="text-3xl font-extrabold text-gray-900">
        Team Connector
    </h1>
    <p class="text-sm text-gray-500 mt-1">「つなぐことで、チームをもっとスムーズに。」</p>
</header>

<!-- ログインフォーム (Devise: new_user_session_path) -->
<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
    <h2 class="text-xl font-bold text-gray-800 text-center mb-4">ログイン</h2>

    <!-- メールアドレス (email) -->
<div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.email_field :email,
        autofocus: true,
        autocomplete: "email",
        required: true,
        class: "w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm placeholder-gray-400 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150",
        placeholder: "example@team.com" %>
</div>

<!-- パスワード (password) -->
<div>
    <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.password_field :password,
        autocomplete: "current-password",
        required: true,
        class: "w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm placeholder-gray-400 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150",
        placeholder: "パスワードを入力" %>
</div>

<% if devise_mapping.rememberable? %>
    <!-- ログイン状態を保持 (remember_me) -->
    <div class="flex items-center justify-between">
        <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" %>
            <%= f.label :remember_me, "ログイン状態を保持する", class: "ml-2 block text-sm text-gray-900" %>
        </div>
    </div>
<% end %>

<!-- ログインボタン (Submit) -->
<div>
    <%= f.submit "ログイン",
        class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-md text-base font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 cursor-pointer" %>
    </div>
<% end %>

<!-- Deviseのヘルパーリンク群 -->
<footer class="mt-8 text-center space-y-3">
    <%= render "devise/shared/links" %>
    <%#
        通常、devise/shared/_linksパーシャルが以下のリンクを提供します。
        もしパーシャルを使わない場合は、以下のように直接記述します。
    %>
    <% if devise_mapping.registerable? && controller_name != 'registrations' %>
        <p class="text-sm">
            <%= link_to "アカウントをお持ちでない方はこちら", new_user_registration_path, class: "font-medium text-indigo-600 hover:text-indigo-500 transition duration-150" %>
        </p>
    <% end %>
    <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
        <p class="text-sm">
            <%= link_to "パスワードをお忘れですか？", new_user_password_path, class: "font-medium text-gray-500 hover:text-gray-700 transition duration-150" %>
        </p>
    <% end %>
</footer>


</div>