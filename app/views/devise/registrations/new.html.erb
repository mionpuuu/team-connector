<div class="app-container">

<!-- アプリロゴとタイトル -->
<header class="text-center mb-8">
    <div class="w-12 h-12 mx-auto bg-indigo-600 rounded-full flex items-center justify-center mb-3 shadow-lg">
  <!-- Lucide: zap（稲妻アイコン） -->
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
       stroke-width="2" stroke="currentColor" class="w-6 h-6 text-white">
    <path stroke-linecap="round" stroke-linejoin="round"
          d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
  </svg>
</div>
    <h1 class="text-3xl font-extrabold text-gray-900">
        Team Connector
    </h1>
    <p class="text-sm text-gray-500 mt-1">「つなぐことで、チームをもっとスムーズに。」</p>
</header>

<!-- サインアップフォーム (Devise: registration_path(resource_name)) -->
<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <h2 class="text-xl font-bold text-gray-800 text-center mb-4">新規アカウント登録</h2>

    <!-- ユーザー名 (name) -->
    <div class="field">
        <%= f.label :username, "ユーザー名", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :username,
            autofocus: true,
            required: true,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm placeholder-gray-400 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150",
            placeholder: "チーム内で表示される名前" %>
    </div>

    <!-- メールアドレス (email) -->
    <div class="field">
        <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email,
            autocomplete: "email",
            required: true,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm placeholder-gray-400 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150",
            placeholder: "example@team.com" %>
    </div>

    <!-- パスワード (password) -->
    <div class="field">
        <%= f.label :password, "パスワード", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password,
            autocomplete: "new-password",
            required: true,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm placeholder-gray-400 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150",
            placeholder: "パスワードを設定" %>
        <% if @minimum_password_length %>
            <p class="text-xs text-gray-500 mt-1">
                （<%= @minimum_password_length %>文字以上）
            </p>
        <% end %>
    </div>

    <!-- パスワード確認 (password_confirmation) -->
    <div class="field">
        <%= f.label :password_confirmation, "パスワード（確認用）", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            required: true,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm placeholder-gray-400 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150",
            placeholder: "もう一度入力してください" %>
    </div>

    <!-- サインアップボタン (Submit) -->
    <div class="actions pt-4">
        <%= f.submit "アカウントを作成する",
            class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-md text-base font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 cursor-pointer" %>
    </div>
<% end %>

<!-- ログインリンク -->
<footer class="mt-8 text-center space-y-3">
    <%= render "devise/shared/links" %>
    <%# new_session_path (ログイン画面へのリンク) %>
    <% if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) %>
        <p class="text-sm">
            <%= link_to "ロック解除のメールを受け取る", new_resource_unlock_path, class: "font-medium text-gray-500 hover:text-gray-700 transition duration-150" %>
        </p>
    <% end %>
</footer>


</div>