
<!-- app/views/dashboards/index.html.erb -->
<div class="min-h-screen bg-gray-50">
  <header class="bg-white shadow-md sticky top-0 z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
      <h1 class="text-2xl font-extrabold text-indigo-600 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor"
             class="w-6 h-6 mr-2 text-indigo-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Team Connector
      </h1>
      <%= link_to edit_user_registration_path, class: "text-gray-600 hover:text-indigo-600 transition duration-150 p-2 rounded-full bg-gray-100" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor"
             class="w-6 h-6 text-gray-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M5.121 17.804A9 9 0 0112 15a9 9 0 016.879 2.804M15 10a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      <% end %>
    </div>
  </header>

  <main class="max-w-4xl mx-auto p-4 sm:p-6 lg:p-8">
    <h2 class="text-3xl font-bold text-gray-900 mb-6">ダッシュボード</h2>

    <div class="flex justify-end space-x-3 mb-6">
  <%= link_to "＋ 試合作成", new_event_path,
      class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg shadow-md transition duration-150" %>

  <%= link_to "＋ お知らせ作成", new_notice_path,
      class: "bg-yellow-500 hover:bg-yellow-600 text-white font-semibold py-2 px-4 rounded-lg shadow-md transition duration-150" %>
</div>
    <!-- カレンダー（仮） -->
    <section class="mb-8 p-4 bg-white rounded-xl shadow-lg border border-gray-200">
      <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor"
             class="w-5 h-5 mr-2 text-indigo-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M6.75 3v2.25M17.25 3v2.25M3 9h18M4.5 9v12h15V9M9 13.5h6"/>
        </svg>
        試合の予定
      </h3>

      <% if @events.present? %>
        <ul class="divide-y divide-gray-200">
          <% @events.each do |event| %>
            <li class="py-3">
              <% wdays = ['日', '月', '火', '水', '木', '金', '土'] %>
              <% wday = wdays[event.date.wday] %>
                <p class="font-semibold text-gray-800">
               <%= event.date.strftime("%-m/%-d") %>（<%= wday %>）<%= link_to event.title, event_path(event) %> 
              </p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-500">今月の予定はありません。</p>
      <% end %>
      <%= link_to events_path, class: "flex items-center text-indigo-600 hover:text-indigo-700 text-sm font-medium mt-3" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         class="w-4 h-4 mr-1">
      <path d="M3 5h.01"/>
      <path d="M3 12h.01"/>
      <path d="M3 19h.01"/>
      <path d="M8 5h13"/>
      <path d="M8 12h13"/>
      <path d="M8 19h13"/>
    </svg>

      試合一覧を見る
      <% end %>


    </section>
    

    <!-- お知らせ -->
    <section class="mb-8">
      <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor"
             class="w-5 h-5 mr-2 text-indigo-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14V11a6.002 6.002 0 00-4-5.659V4a2 2 0 10-4 0v1.341C7.67 6.165 6 8.388 6 11v3a2.03 2.03 0 01-.595 1.405L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
        お知らせ
      </h3>

      <% @notices.each do |notice| %>
        <div class="bg-white p-4 rounded-lg shadow-sm mb-3 border border-gray-200">
          <h4 class="font-semibold text-gray-800"><%= notice.title %></h4>
          <p class="text-sm text-gray-600 mb-2"><%= truncate(notice.content, length: 10) %></p>
          <p class="text-xs text-gray-400">  <%= notice.created_at.strftime("%Y年%-m月%-d日（#{['日','月','火','水','木','金','土'][notice.created_at.wday]}）") %>
</p>
          <%= link_to notice_path(notice), class: "flex items-center text-indigo-600 hover:text-indigo-700 text-sm font-medium mt-3" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             class="w-4 h-4 mr-1">
            <circle cx="12" cy="12" r="10"/>
           <path d="m10 8 4 4-4 4"/>
            </svg>
            詳細を見る
            <% end %>
         
        </div>
      <% end %>

      <div class="mt-3 text-right">
  <%= link_to notices_path, class: "flex items-center text-indigo-600 hover:text-indigo-700 text-sm font-medium mt-3" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         class="w-4 h-4 mr-1">
      <path d="M3 5h.01"/>
      <path d="M3 12h.01"/>
      <path d="M3 19h.01"/>
      <path d="M8 5h13"/>
      <path d="M8 12h13"/>
      <path d="M8 19h13"/>
    </svg>
    お知らせ一覧を見る
  <% end %>
</div>
    </section>
  </main>
</div>

<%= javascript_include_tag "dashboard", "data-turbo-track": "reload" %>
