<div class="min-h-screen bg-gray-100">
  
  <!-- ヘッダーエリア-->
    <%= render 'shared/header' %>
  
  <main class="max-w-4xl mx-auto p-4 sm:p-6 lg:p-8">
    <h2 class="text-3xl font-bold text-gray-900 mb-6">ダッシュボード</h2>

    <!-- 🌟 メインアクションボタン群 -->
    <div class="flex justify-center gap-x-4 mb-8">
      <%= link_to new_event_path,
          class: "flex items-center justify-center w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition duration-150 transform hover:scale-[1.02] text-lg" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus mr-2"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        試合作成
      <% end %>

      <%= link_to new_notice_path,
          class: "flex items-center justify-center w-full sm:w-auto bg-amber-600 hover:bg-amber-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition duration-150 transform hover:scale-[1.02] text-lg" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-edit mr-2"><path d="M17 3a2.85 2.85 0 0 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
        お知らせ作成
      <% end %>

    </div>
    
    <!-- 📅 試合の予定セクション -->
    <section class="mb-8 p-6 bg-white rounded-2xl shadow-xl border-t-8 border-indigo-500">
      <h3 class="text-2xl font-extrabold text-gray-800 mb-5 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             class="w-6 h-6 mr-2 text-indigo-600">
          <path d="M8 2v4"/>
          <path d="M16 2v4"/>
          <rect width="18" height="18" x="3" y="4" rx="2"/>
          <path d="M3 10h18"/>
        </svg>
        試合の予定
      </h3>

      <% if @events.present? %>
        <ul class="space-y-4">
          <% @events.each do |event| %>
            <li class="p-4 bg-indigo-50 rounded-xl hover:bg-indigo-100 transition duration-150 border border-indigo-200">
              <% wdays = ['日', '月', '火', '水', '木', '金', '土'] %>
              <% wday = wdays[event.date.wday] %>
              
              <%= link_to event_path(event), class: "group block" do %>
                <div class="flex items-center justify-between">
                  <div class="flex items-center">
                    <span class="text-xl font-bold text-indigo-700 mr-3">
                      <%= event.date.strftime("%-m/%-d") %>（<%= wday %>）
                    </span>
                    <span class="text-base text-gray-700 font-medium">
                       <%= event.time.present? ? event.time.strftime("%H:%M") : '時間未定' %>
                    </span>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right text-indigo-600 group-hover:translate-x-1 transition"><path d="m9 18 6-6-6-6"/></svg>
                </div>
                <p class="mt-1 text-lg font-bold text-gray-900 group-hover:text-indigo-800 transition"><%= event.title %></p>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-600 text-lg p-3 bg-gray-50 rounded-lg">今月の予定はありません。ゆっくり休んでくださいね。</p>
      <% end %>
      
      <%= link_to events_path, class: "flex items-center text-indigo-600 hover:text-indigo-700 text-base font-bold mt-5 pt-3 border-t border-indigo-100" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         class="w-5 h-5 mr-1">
          <path d="M3 5h.01"/>
          <path d="M3 12h.01"/>
          <path d="M3 19h.01"/>
          <path d="M8 5h13"/>
          <path d="M8 12h13"/>
          <path d="M8 19h13"/>
        </svg>
        すべての試合一覧を見る
      <% end %>
    </section>
    
    <!-- 📰 お知らせセクション -->
    <section class="mb-8 p-6 bg-white rounded-2xl shadow-xl border-t-8 border-amber-500">
    <h3 class="text-2xl font-extrabold text-gray-800 mb-5 flex items-center">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
           stroke-width="2" stroke="currentColor"
           class="w-6 h-6 mr-2 text-amber-600">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14V11a6.002 6.002 0 00-4-5.659V4a2 2 0 10-4 0v1.341C7.67 6.165 6 8.388 6 11v3a2.03 2.03 0 01-.595 1.405L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
      </svg>
      今月のお知らせ
    </h3>

    <!-- 📌 重要なお知らせ -->
    <% if @pinned_notices.present? %>
      <div class="bg-amber-50 border-l-4 border-amber-400 p-4 mb-6 rounded-xl shadow-md">
        <h4 class="text-xl font-bold text-amber-700 mb-3 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               class="w-6 h-6 mr-2 text-amber-600 fill-amber-300">
            <path d="M6 22V2.8a.8.8 0 0 1 1.17-.71l11.38 5.69a.8.8 0 0 1 0 1.44L6 15.5"/>
          </svg>
          【重要】必ずご確認ください
        </h4>
        <% @pinned_notices.each do |notice| %>
          <div class="bg-white p-4 rounded-lg shadow-sm mb-3 border border-amber-200 hover:bg-amber-100 transition">
            <%= link_to notice_path(notice), class: "group block" do %>
              <h5 class="font-bold text-amber-800 text-lg flex justify-between items-start">
                <%= notice.title %>
                <span class="ml-2 bg-amber-600 text-white text-xs font-bold px-2 py-0.5 rounded-full whitespace-nowrap">重要</span>
              </h5>
              <p class="text-sm text-gray-600 mt-1"><%= truncate(notice.content, length: 30) %></p>
              <p class="text-xs text-gray-400 mt-2">
                <span class="font-medium text-gray-500 mr-2">投稿日:</span>
                <%= notice.created_at.strftime("%Y年%-m月%-d日（#{['日','月','火','水','木','金','土'][notice.created_at.wday]}）") %>
              </p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- 📰 通常のお知らせ -->
    <% if @notices.any? %>
      <ul class="space-y-3">
        <% @notices.each do |notice| %>
          <li class="bg-gray-50 p-4 rounded-xl shadow-sm border border-gray-200 hover:bg-gray-100 transition duration-150">
            <%= link_to notice_path(notice), class: "group block" do %>
              <h5 class="font-bold text-gray-800 text-lg group-hover:text-amber-700 transition"><%= notice.title %></h5>
              <p class="text-sm text-gray-600 mt-1"><%= truncate(notice.content, length: 25) %></p>
              <p class="text-xs text-gray-400 mt-2">
                <span class="font-medium text-gray-500 mr-2">投稿日:</span>
                <%= notice.created_at.strftime("%Y年%-m月%-d日（#{['日','月','火','水','木','金','土'][notice.created_at.wday]}）") %>
              </p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-600 text-lg p-3 bg-gray-50 rounded-lg">最近新しいお知らせはありません。</p>
    <% end %>

    <div class="mt-5 text-right">
      <%= link_to notices_path, class: "flex items-center text-amber-600 hover:text-amber-700 text-base font-bold mt-3 pt-3 border-t border-amber-100" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             class="w-5 h-5 mr-1">
          <path d="M3 5h.01"/>
          <path d="M3 12h.01"/>
          <path d="M3 19h.01"/>
          <path d="M8 5h13"/>
          <path d="M8 12h13"/>
          <path d="M8 19h13"/>
        </svg>
        過去のお知らせ一覧を見る
      <% end %>
    </div>
  </section>
  <div class="mt-5">
    <%= javascript_include_tag "dashboard", "data-turbo-track": "reload", crossorigin: "anonymous" %>
  </div>
</div>
