<div class="min-h-screen bg-gray-100">
  
  <!-- ヘッダーエリア -->
  <header class="bg-white shadow-lg sticky top-0 z-10 border-b-4 border-amber-500">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between gap-x-4">
      <h1 class="text-2xl font-extrabold text-amber-600 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor"
             class="w-7 h-7 mr-2 text-amber-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Team Connector
      </h1>

      <%= link_to edit_user_registration_path, class: "ml-4 text-gray-600 hover:text-amber-600 transition duration-150 p-2 rounded-full bg-amber-50" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor"
             class="w-6 h-6 text-amber-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M5.121 17.804A9 9 0 0112 15a9 9 0 016.879 2.804M15 10a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      <% end %>
    </div>
  </header>
  
  <main class="max-w-4xl mx-auto p-4 sm:p-6 lg:p-8">
    
    <!-- パンくずナビゲーション -->
    <div class="mb-6 flex items-center text-sm text-gray-600">
      <%= link_to root_path, class: "hover:text-amber-600 transition flex items-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        ダッシュボード
      <% end %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
           stroke-width="2" stroke="currentColor" class="w-4 h-4 mx-2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
      <%= link_to notices_path, class: "hover:text-amber-600 transition" do %>
        お知らせ一覧
      <% end %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
           stroke-width="2" stroke="currentColor" class="w-4 h-4 mx-2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-gray-900 font-medium">新規作成</span>
    </div>

    <!-- ページタイトル -->
    <div class="mb-6">
      <h2 class="text-3xl font-bold text-gray-900 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor" class="w-8 h-8 mr-2 text-amber-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 110-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 01-1.44-4.282m3.102.069a18.03 18.03 0 01-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 018.835 2.535M10.34 6.66a23.847 23.847 0 008.835-2.535m0 0A23.74 23.74 0 0018.795 3m.38 1.125a23.91 23.91 0 011.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 001.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 010 3.46"/>
        </svg>
        お知らせ新規作成
      </h2>
      <p class="text-gray-600 mt-2">メンバーに伝えたい情報を入力してください</p>
    </div>

    <!-- エラーメッセージ -->
    <% if @notice.errors.any? %>
      <div class="mb-6 p-6 bg-red-50 border-l-8 border-red-500 rounded-2xl shadow-xl">
        <h3 class="text-lg font-bold text-red-700 mb-3 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke-width="2" stroke="currentColor" class="w-6 h-6 mr-2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
          </svg>
          入力にエラーがあります
        </h3>
        <ul class="list-disc list-inside space-y-1 text-sm text-red-600">
          <% @notice.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- フォームセクション -->
    <section class="p-6 bg-white rounded-2xl shadow-xl border-t-8 border-amber-500">
      <%= form_with model: @notice, local: true, class: "space-y-6" do |f| %>
        
        <!-- タイトル -->
        <div>
          <%= f.label :title, class: "block text-sm font-bold text-gray-700 mb-2 flex items-center" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-1 text-amber-600">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13L2 21.75l.8-2.685a4.5 4.5 0 011.13-1.897l12.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
            </svg>
            タイトル
            <span class="text-red-500 ml-1">*</span>
          <% end %>
          <%= f.text_field :title, 
              required: true,
              class: "w-full border-2 border-gray-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition",
              placeholder: "例: 来週の練習について" %>
        </div>

        <!-- 内容 -->
        <div>
          <%= f.label :content, class: "block text-sm font-bold text-gray-700 mb-2 flex items-center" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-1 text-amber-600">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
            </svg>
            内容
            <span class="text-red-500 ml-1">*</span>
          <% end %>
          <%= f.text_area :content, rows: 8,
              required: true,
              class: "w-full border-2 border-gray-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition resize-y",
              placeholder: "メンバーに伝えたい情報を詳しく入力してください" %>
        </div>

        <!-- 画像アップロード -->
        <div>
          <%= f.label :images, class: "block text-sm font-bold text-gray-700 mb-2 flex items-center" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-1 text-amber-600">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
            </svg>
            画像の追加（任意）
          <% end %>
          <div class="border-2 border-dashed border-gray-300 rounded-xl p-6 text-center hover:border-amber-400 transition">
            <%= f.file_field :images, multiple: true, accept: "image/*",
                class: "block w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-amber-50 file:text-amber-700 hover:file:bg-amber-100 cursor-pointer" %>
            <p class="text-xs text-gray-500 mt-2">PNG, JPG, GIF（複数選択可）</p>
          </div>
        </div>

        <!-- ピン留めチェックボックス -->
        <div class="border-2 border-gray-200 rounded-xl p-4 bg-gray-50">
          <label class="flex items-start cursor-pointer">
            <%= f.check_box :pinned, class: "mt-1 mr-3 w-5 h-5 text-amber-600 border-gray-300 rounded focus:ring-amber-500" %>
            <div>
              <span class="text-sm font-bold text-gray-700 flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="w-4 h-4 mr-1 text-amber-600">
                  <path d="M6 22V2.8a.8.8 0 0 1 1.17-.71l11.38 5.69a.8.8 0 0 1 0 1.44L6 15.5"/>
                </svg>
                重要なお知らせとして固定する
              </span>
              <p class="text-xs text-gray-600 mt-1">チェックすると、ダッシュボードの上部に常に表示されます</p>
            </div>
          </label>
        </div>

        <!-- 送信ボタン -->
        <div class="flex flex-col gap-3 pt-4">
          <%= f.submit "お知らせを作成する",
              class: "w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-4 px-6 rounded-xl shadow-lg transition duration-150 transform hover:scale-[1.02] cursor-pointer" %>

          <%= link_to root_path,
              class: "w-full bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-4 px-6 rounded-xl shadow-lg transition duration-150 text-center block" do %>
            キャンセル
          <% end %>
        </div>

      <% end %>
    </section>

  </main>
</div>