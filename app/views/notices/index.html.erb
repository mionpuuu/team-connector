<div class="min-h-screen bg-gray-100">
  
  <!-- ヘッダーエリア -->
  <header class="bg-white shadow-lg sticky top-0 z-10 border-b-4 border-amber-500">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between gap-x-4">
      <h1 class="text-2xl font-extrabold text-amber-600 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor"
             class="w-7 h-7 mr-2 text-amber-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Team Connector
      </h1>

      <%= link_to edit_user_registration_path, class: "ml-4 text-gray-600 hover:text-amber-600 transition duration-150 p-2 rounded-full bg-amber-50" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor"
             class="w-6 h-6 text-amber-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M5.121 17.804A9 9 0 0112 15a9 9 0 016.879 2.804M15 10a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      <% end %>
    </div>
  </header>
  
  <main class="max-w-4xl mx-auto p-4 sm:p-6 lg:p-8">
    
    <!-- パンくずナビゲーション -->
    <div class="mb-6 flex items-center text-sm text-gray-600">
      <%= link_to root_path, class: "hover:text-amber-600 transition flex items-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        ダッシュボード
      <% end %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
           stroke-width="2" stroke="currentColor" class="w-4 h-4 mx-2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-gray-900 font-medium">お知らせ一覧</span>
    </div>

    <!-- ページタイトル & アクションボタン -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 gap-4">
      <h2 class="text-3xl font-bold text-gray-900 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor"
             class="w-8 h-8 mr-2 text-amber-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14V11a6.002 6.002 0 00-4-5.659V4a2 2 0 10-4 0v1.341C7.67 6.165 6 8.388 6 11v3a2.03 2.03 0 01-.595 1.405L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
        お知らせ一覧
      </h2>

      <%= link_to new_notice_path,
          class: "flex items-center justify-center bg-amber-600 hover:bg-amber-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition duration-150 transform hover:scale-[1.02]" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        お知らせ作成
      <% end %>
    </div>
    
    <!-- 📌 重要なお知らせ (ピン留め) -->
    <% pinned_notices = @notices.select(&:pinned) %>
    <% if pinned_notices.present? %>
      <section class="mb-8 p-6 bg-amber-50 rounded-2xl shadow-xl border-l-8 border-amber-400">
        <h3 class="text-xl font-extrabold text-amber-700 mb-5 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               class="w-6 h-6 mr-2 text-amber-600 fill-amber-300">
            <path d="M6 22V2.8a.8.8 0 0 1 1.17-.71l11.38 5.69a.8.8 0 0 1 0 1.44L6 15.5"/>
          </svg>
          【重要】ピン留めされたお知らせ
        </h3>
        
        <ul class="space-y-3">
          <% pinned_notices.each do |notice| %>
            <li class="p-4 bg-white rounded-xl hover:bg-amber-100 transition duration-150 border border-amber-200 shadow-sm">
              <%= link_to notice_path(notice), class: "group block" do %>
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <div class="flex items-center gap-2 mb-1">
                      <h4 class="text-lg font-bold text-amber-800 group-hover:text-amber-900 transition">
                        <%= notice.title %>
                      </h4>
                      <span class="bg-amber-600 text-white text-xs font-bold px-2 py-0.5 rounded-full whitespace-nowrap">重要</span>
                    </div>
                    <p class="text-sm text-gray-600 mt-1"><%= truncate(notice.content, length: 50) %></p>
                    <p class="text-xs text-gray-400 mt-2">
                      <%= notice.created_at.strftime("%Y年%-m月%-d日（#{['日','月','火','水','木','金','土'][notice.created_at.wday]}）") %>
                    </p>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600 group-hover:translate-x-1 transition flex-shrink-0 mt-1"><path d="m9 18 6-6-6-6"/></svg>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <!-- 📰 通常のお知らせ一覧 -->
    <section class="mb-8 p-6 bg-white rounded-2xl shadow-xl border-t-8 border-amber-500">
      <h3 class="text-xl font-extrabold text-gray-800 mb-5 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor" class="w-6 h-6 mr-2 text-amber-600">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
        </svg>
        すべてのお知らせ
      </h3>

      <% normal_notices = @notices.reject(&:pinned) %>
      <% if normal_notices.any? %>
        <ul class="space-y-3">
          <% normal_notices.each do |notice| %>
            <li class="p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition duration-150 border border-gray-200">
              <%= link_to notice_path(notice), class: "group block" do %>
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <h4 class="text-lg font-bold text-gray-900 group-hover:text-amber-700 transition">
                      <%= notice.title %>
                    </h4>
                    <p class="text-sm text-gray-600 mt-1"><%= truncate(notice.content, length: 50) %></p>
                    <p class="text-xs text-gray-400 mt-2">
                      <%= notice.created_at.strftime("%Y年%-m月%-d日（#{['日','月','火','水','木','金','土'][notice.created_at.wday]}）") %>
                    </p>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600 group-hover:translate-x-1 transition flex-shrink-0 mt-1"><path d="m9 18 6-6-6-6"/></svg>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <% if pinned_notices.present? %>
          <p class="text-gray-600 text-center py-4">通常のお知らせはありません。</p>
        <% else %>
          <div class="text-center py-12">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="1.5" stroke="currentColor"
                 class="w-16 h-16 mx-auto text-gray-400 mb-4">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
            </svg>
            <p class="text-gray-600 text-lg">お知らせはまだありません。</p>
            <p class="text-gray-500 text-sm mt-2">「お知らせ作成」ボタンから新しいお知らせを投稿しましょう!</p>
          </div>
        <% end %>
      <% end %>
    </section>

    <!-- ダッシュボードに戻るリンク -->
    <div class="flex justify-center">
      <%= link_to root_path,
          class: "flex items-center gap-2 px-6 py-3 bg-white hover:bg-gray-50 rounded-xl border-2 border-gray-300 shadow-md transition duration-150 text-gray-700 font-medium" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        ダッシュボードに戻る
      <% end %>
    </div>

  </main>
</div>